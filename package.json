{
  "name": "dotnote",
  "private": true,
  "license": "SEE LICENSE IN LICENSE.md",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "pnpm --filter dotnote-app dev",
    "dev:legacy": "pnpm --filter dotnote-legacy-app dev",
    "build": "pnpm --filter dotnote-app build",
    "build:cf": "pnpm --filter dotnote-app run build:cf",
    "build:legacy": "pnpm --filter dotnote-legacy-app build",
    "deploy:app": "pnpm --filter dotnote-app run deploy:cf",
    "preview:app": "pnpm --filter dotnote-app run preview:cf",
    "deploy:legacy": "pnpm --filter dotnote-legacy-app run deploy",
    "pack:release": "node scripts/pack-release.mjs",
    "release:key": "node scripts/release-key.mjs",
    "deploy:installer": "node scripts/pack-release.mjs && pnpm --filter dotnote-installer run deploy",
    "dev:installer": "pnpm --filter dotnote-installer dev"
  }
}
