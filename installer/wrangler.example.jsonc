{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dotnote-installer",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dotnote-installer",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "OAUTH_CLIENT_ID": "REPLACE_WITH_CLOUDFLARE_OAUTH_CLIENT_ID",
    "DOTNOTE_DIAGNOSTICS_URL": "https://diagnostics.example.com",
    "OAUTH_SCOPES": "account-settings.read workers-scripts.read workers-scripts.write d1.read d1.write workers-r2.read workers-r2.write zone.read dns.read dns.write ssl-and-certificates.write workers-routes.write"
  }
}
