{
  "name": "dotnote-app",
  "version": "0.2.1",
  "private": true,
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "scripts": {
    "dev": "pnpm run db:migrate:local && vite build && concurrently -k -n web,assets,worker -c blue,yellow,green \"vite\" \"vite build --watch\" \"wrangler dev --port 8787\"",
    "db:migrate:local": "wrangler d1 migrations apply dotnote-index --local",
    "build": "tsc --noEmit && vite build",
    "deploy": "pnpm run build && wrangler deploy"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@blocknote/core": "^0.51.4",
    "@blocknote/react": "^0.51.4",
    "@blocknote/shadcn": "^0.51.4",
    "@hono/zod-validator": "^0.4.3",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-context-menu": "^2.2.15",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.12",
    "@uiw/react-markdown-preview": "^5.2.1",
    "browser-image-compression": "^2.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "hono": "^4.7.2",
    "lucide-react": "^0.525.0",
    "minisearch": "^7.1.0",
    "mobx": "^7.0.0",
    "mobx-react-lite": "^5.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sonner": "^2.0.6",
    "tailwind-merge": "^3.6.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261026.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "concurrently": "^9.1.2",
    "tailwindcss": "^4",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "wrangler": "^4.34.0"
  }
}
